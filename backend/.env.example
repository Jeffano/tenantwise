# Copy to backend/.env for local development. Never commit the real .env file.
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
IP_HASH_SALT=generate-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000
# Local runs store the embedding model here instead of /models
MODEL_CACHE_DIR=./.models
# Optional overrides
# SMALL_MODEL=claude-haiku-4-5
# LARGE_MODEL=claude-sonnet-5-5
# SCOPE_THRESHOLD=0.55
# DAILY_BUDGET_USD=0.30
